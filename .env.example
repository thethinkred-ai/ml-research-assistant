# Прокси LLM-ключа (backend/proxy.js). Скопируйте в .env и заполните.
# Формат имён моделей «вендор/модель:free» — как у OpenRouter (текущий продакшн).

# Ключ апстрима (ОБЯЗАТЕЛЬНО). Не коммитить — .env в .gitignore.
UPSTREAM_KEY=sk-...

# Апстрим, OpenAI-совместимый /chat/completions
UPSTREAM_URL=https://openrouter.ai/api/v1

# Разрешённые модели (whitelist: что угодно дорогое клиент не закажет)
ALLOW_MODELS=nvidia/nemotron-3-super-120b-a12b:free,gpt-4o-mini,gpt-4o

# Origin фронтенда (для CORS); при same-origin (/api на том же домене) не используется
ALLOW_ORIGIN=https://thinkred.ru

# Защита бюджета: лимиты запросов
RATE_PER_MIN=6
RATE_PER_HOUR=40
DAILY_LIMIT=300

# Сетевые настройки прокси
HOST=0.0.0.0
PORT=8787
UPSTREAM_TIMEOUT_MS=120000
BODY_LIMIT=2000000
